{
  "cli": {
    "version": ">= 18.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_IMAGE_UTILS_NO_SHARP": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_IMAGE_UTILS_NO_SHARP": "1"
      }
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "ios-test": {
      "extends": "preview",
      "withoutCredentials": true,
      "ios": {
        "simulator": true,
        "config": "ios-test.yml"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_IMAGE_UTILS_NO_SHARP": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6761445679"
      }
    }
  }
}
